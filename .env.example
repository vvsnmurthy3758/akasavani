# Copy this file to `.env` and adjust if needed.

# --- English (Coqui) --------------------------------------------------------
MODEL_NAME=tts_models/en/vctk/vits
PORT=5002
COQUI_TOS_AGREED=1

# Show all ~109 English voices instead of the curated shortlist.
# AKASAVANI_ALL_SPEAKERS=1

# --- Telugu (తెలుగు) ---------------------------------------------------------
# Turn Telugu on/off in the web UI.
AKASAVANI_TELUGU=1
# auto | piper | mms | indicf5
#   auto    -> IndicF5 when a reference clip + transcript + HF token exist,
#              otherwise Piper, otherwise the built-in MMS voice.
#   piper   -> rhasspy/piper-voices, three Telugu voices, ~63 MB, no login
#              (this is the default and the recommended choice).
#   mms     -> facebook/mms-tts-tel (single voice, ~145 MB, no login).
#   indicf5 -> ai4bharat/IndicF5 (best quality; gated model, needs a reference).
AKASAVANI_TELUGU_ENGINE=auto

# Default Piper voice: padmavathi | venkatesh | maya.
# (The web UI also lets you switch voices per request.)
# AKASAVANI_TELUGU_VOICE=padmavathi
# Where Piper stores downloaded voices. Defaults to ~/.cache/akasavani/piper.
# AKASAVANI_PIPER_DIR=C:\Users\you\.cache\akasavani\piper

# Required only for the IndicF5 engine. Accept the model terms at
# https://huggingface.co/ai4bharat/IndicF5 then run `huggingface-cli login`,
# and point these at a short Telugu clip and its exact transcript.
# INDICF5_REF_AUDIO=C:\path\to\telugu_reference.wav
# INDICF5_REF_TEXT=మీ రిఫరెన్స్ ఆడియోలో ఉన్న వాక్యం
